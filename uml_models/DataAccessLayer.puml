@startuml DataAccessLayer
title Data Access Layer

package "com.data_management" {

  abstract class DataListener {
    # sourceAddress : String
    + DataListener(sourceAddress : String)
    + connect() : void
    + disconnect() : void
    + startListening() : void
  }

  class TCPDataListener {
    - port : int
    + TCPDataListener(port : int)
    + connect() : void
    + disconnect() : void
    + startListening() : void
  }

  class WebSocketDataListener {
    - port : int
    + WebSocketDataListener(port : int)
    + connect() : void
    + disconnect() : void
    + startListening() : void
  }

  class FileDataListener {
    - directoryPath : String
    + FileDataListener(directoryPath : String)
    + connect() : void
    + disconnect() : void
    + startListening() : void
  }

  class DataParser {
    + parse(rawLine : String) : PatientRecord
    - detectFormat(raw : String) : String
    - validateFields(fields : String[]) : boolean
  }

  class DataSourceAdapter {
    - listener : DataListener
    - parser : DataParser
    - storage : DataStorage
    + DataSourceAdapter(listener : DataListener, parser : DataParser, storage : DataStorage)
    + start() : void
    + stop() : void
  }

  class DataStorage {
    + addPatientData(patientId : int, value : double, type : String, timestamp : long) : void
  }

  class PatientRecord {
    - patientId : int
    - recordType : String
    - measurementValue : double
    - timestamp : long
  }
}

TCPDataListener --|> DataListener
WebSocketDataListener --|> DataListener
FileDataListener --|> DataListener
DataSourceAdapter --> DataListener : uses >
DataSourceAdapter --> DataParser : uses >
DataSourceAdapter --> DataStorage : populates >
DataParser ..> PatientRecord : produces >

@enduml
