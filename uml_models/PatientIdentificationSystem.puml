@startuml PatientIdentificationSystem
title Patient Identification System

package "com.patient_identification" {

  class PatientIdentifier {
    - idMappings : Map<Integer, String>
    - strategy : IdentificationStrategy
    + PatientIdentifier(strategy : IdentificationStrategy)
    + identify(simulatorId : int) : HospitalPatient
    + registerMapping(simulatorId : int, hospitalId : String) : void
  }

  interface IdentificationStrategy {
    + match(simulatorId : int, db : PatientDatabase) : HospitalPatient
  }

  class IdMatchStrategy {
    + match(simulatorId : int, db : PatientDatabase) : HospitalPatient
  }

  class HospitalPatient {
    - hospitalId : String
    - name : String
    - dateOfBirth : String
    - medicalHistory : List<String>
    + getHospitalId() : String
    + getName() : String
    + getMedicalHistory() : List<String>
  }

  class PatientDatabase {
    - records : Map<String, HospitalPatient>
    + findById(hospitalId : String) : HospitalPatient
    + addPatient(patient : HospitalPatient) : void
  }

  class IdentityManager {
    - identifier : PatientIdentifier
    - mismatchLog : List<MismatchRecord>
    + verifyIntegrity() : void
    + handleMismatch(simulatorId : int) : void
  }

  class MismatchRecord {
    - simulatorId : int
    - timestamp : long
    - reason : String
  }
}

PatientIdentifier --> IdentificationStrategy : uses >
PatientIdentifier --> PatientDatabase : queries >
IdMatchStrategy ..|> IdentificationStrategy
PatientDatabase "1" *-- "0..*" HospitalPatient : stores >
IdentityManager --> PatientIdentifier : manages >
IdentityManager "1" *-- "0..*" MismatchRecord : logs >

@enduml
